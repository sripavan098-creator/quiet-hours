# Copy to .env (never commit .env). Names only; no real values here.

# "dev" enables the demo endpoint and the default webhook key. Leave unset in production.
QH_ENV=

# HMAC key from the Ring Developer Portal. Required outside QH_ENV=dev.
RING_WEBHOOK_SECRET=

# JSON map of Ring device ID to room, e.g. {"ava1.ring.device.<id>": "kitchen"}
RING_DEVICE_ZONES={}

# Ring app credentials (for the Partner API client)
RING_CLIENT_ID=
RING_CLIENT_SECRET=

# Partner API base. Override only if Ring directs you to a different host.
RING_API_BASE=https://api.amazonvision.com

# Listen port
PORT=8080
QH_DB_PATH=data/quiet_hours.db
